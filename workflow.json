      "parameters": {
        "jsCode": "const slaHoursMap = { 'Critical': 2, 'High': 8, 'Medium': 24, 'Low': 72 };\nconst now = new Date();\n\nreturn items.map(item => {\n  const t = item.json;\n  const slaHours = slaHoursMap[t.Priority] || 24;\n  const created = new Date(t['Created Date']);\n  const deadline = new Date(created.getTime() + slaHours * 60 * 60 * 1000);\n  const hoursRemaining = (deadline - now) / (1000 * 60 * 60);\n\n  let slaStatus = 'ضمن الوقت';\n  if (hoursRemaining <= 0) slaStatus = 'تم التجاوز';\n  else if (hoursRemaining <= slaHours * 0.2) slaStatus = 'قريب من التجاوز';\n\n  return { json: { ...t, slaHours, hoursRemaining: hoursRemaining.toFixed(1), slaStatus } };\n}).filter(i => i.json.slaStatus !== 'ضمن الوقت');"
      },
